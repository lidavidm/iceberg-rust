@PACKAGE_INIT@

set(ICEBERG_C_FULL_SO_VERSION "@ICEBERG_C_FULL_SO_VERSION@")
set(ICEBERG_C_INSTALL_LIBDIR "@CMAKE_INSTALL_LIBDIR@")
set(ICEBERG_C_SO_VERSION "@ICEBERG_C_SO_VERSION@")
set(ICEBERG_C_VERSION "@PROJECT_VERSION@")

get_filename_component(_IMPORT_PREFIX "${CMAKE_CURRENT_LIST_FILE}" PATH)
get_filename_component(_IMPORT_PREFIX "${_IMPORT_PREFIX}" PATH)
get_filename_component(_IMPORT_PREFIX "${_IMPORT_PREFIX}" PATH)
get_filename_component(_IMPORT_PREFIX "${_IMPORT_PREFIX}" PATH)
if(_IMPORT_PREFIX STREQUAL "/")
  set(_IMPORT_PREFIX "")
endif()

set(base_name iceberg_c)

add_library(IcebergC::iceberg_c_shared SHARED IMPORTED)
set(shared_base_name
  "${CMAKE_SHARED_LIBRARY_PREFIX}${base_name}${CMAKE_SHARED_LIBRARY_SUFFIX}")
set(shared_prefix "${_IMPORT_PREFIX}/${ICEBERG_C_INSTALL_LIBDIR}")
if(WINDOWS)
  set(import_base_name
    "${CMAKE_IMPORT_LIBRARY_PREFIX}${base_name}${CMAKE_IMPORT_LIBRARY_SUFFIX}")
  set_target_properties(IcebergC::iceberg_c_shared
    PROPERTIES
    IMPORTED_IMPLIB "${shared_prefix}/${import_base_name}"
    IMPORTED_LOCATION "${_IMPORT_PREFIX}/bin/${shared_base_name}")
else()
  set_target_properties(IcebergC::iceberg_c_shared
    PROPERTIES
    IMPORTED_LOCATION "${shared_prefix}/${shared_base_name}.${ICEBERG_C_FULL_SO_VERSION}"
    IMPORTED_SONAME "${shared_prefix}/${shared_base_name}.${ICEBERG_C_SO_VERSION}")
endif()

add_library(IcebergC::iceberg_c_static STATIC IMPORTED)
set(static_base_name
  "${CMAKE_STATIC_LIBRARY_PREFIX}${base_name}${CMAKE_STATIC_LIBRARY_SUFFIX}")
if(WINDOWS)
  set_target_properties(IcebergC::iceberg_c_static
    PROPERTIES
    IMPORTED_LOCATION "${_IMPORT_PREFIX}/bin/${static_base_name}")
else()
  set(static_prefix "${_IMPORT_PREFIX}/${ICEBERG_C_INSTALL_LIBDIR}")
  set_target_properties(IcebergC::iceberg_c_static
    PROPERTIES
    IMPORTED_LOCATION "${static_prefix}/${static_base_name}")
endif()

check_required_components(IcebergC)

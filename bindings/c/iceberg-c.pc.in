prefix=@CMAKE_INSTALL_PREFIX@
includedir=@ICEBERG_C_INCLUDEDIR@
libdir=@ICEBERG_C_LIBDIR@

Name: Apache Iceberg C library
Description: C bindings for the Apache Iceberg Rust implementation
URL: https://github.com/apache/iceberg-rust
Version: @PROJECT_VERSION@
Libs: -L${libdir} -liceberg-c
Cflags: -I${includedir}
